# Copy to .env.kane in the project root (git-ignored) and fill in:  cp kane/env.example .env.kane
# These are TEST accounts on your Supabase project. Never use real user credentials here.
# Kane receives the passwords as secret variables and they are redacted from every report.
KANE_BASE_URL=http://localhost:5173

KANE_BUYER_EMAIL=
KANE_BUYER_PASSWORD=
KANE_LANDLORD_EMAIL=
KANE_LANDLORD_PASSWORD=
KANE_VERIFIER_EMAIL=
KANE_VERIFIER_PASSWORD=
KANE_ADMIN_EMAIL=
KANE_ADMIN_PASSWORD=

# Password used when scenario K02 registers a brand new throwaway buyer.
KANE_REGISTER_PASSWORD=
